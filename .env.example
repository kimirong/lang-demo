# ===== lang-demo 环境变量模板 =====
# 复制此文件为 .env 并填入你自己的密钥：
#   cp .env.example .env
# .env 已被 gitignore，永远不会提交到仓库。

# DeepSeek API 密钥（OpenAI 兼容接口）——必填
DEEPSEEK_API_KEY=在这里填你的deepseek_key

# ===== LangSmith 观测平台（Phase 5 才需要，可选）=====
# 到 https://smith.langchain.com 注册获取
LANGSMITH_API_KEY=在这里填你的langsmith_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lang-demo

# ===== 代理（可选：仅当你的网络需要代理访问境外服务时）=====
# 注：用 HTTP 代理即可；socks5(ALL_PROXY) 需要额外安装 socksio 包
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=api.deepseek.com,localhost,127.0.0.1
